# Helpers
# -------

# Returns a human-readable elapsed time string in HH:MM:SS format.
def format_elapsed_time(seconds)
    total = seconds.to_i
    h = total / 3600
    m = (total % 3600) / 60
    s = total % 60
    format("%02d:%02d:%02d", h, m, s)
end

# Checks if beta build of the design system toolbox app points to develop branch of Swift Package,
 # i.e. points to a branch
 def check_package_version_for_beta_app()
    puts "👉 Check package version for MISO iOS Swift package (beta)"
    
    package_resolved_content = File.read("../#{MISO_PACKAGE_RESOLVED_PATH}")
    package_resolved_json_content = JSON.parse(package_resolved_content)
    miso_ios_obj = package_resolved_json_content['pins'].find { |pin| pin["identity"] == "miso-ios" }
        
    return miso_ios_obj.dig("state", "branch") == "develop"

end

 # Checks if the current version of the MISO Swift Package is the expected one for stable builds of the app;
 # i.e. points to a tag
def check_package_version_for_stable_app()
    puts "👉 Check package version for MISO iOS Swift package (stable)"

    package_resolved_content = File.read("../#{MISO_PACKAGE_RESOLVED_PATH}")
    package_resolved_json_content = JSON.parse(package_resolved_content)
    miso_ios_obj = package_resolved_json_content['pins'].find { |pin| pin["identity"] == "miso-ios" }
        
    return !miso_ios_obj.dig("state", "version").nil?
end

# Extract from Package.resolved details about the version in use of the MISO iOS Swift Package.
# Returns a string with branch and revision on 8 digits or tag and revision on 8 digits
def MISO_swift_package_version()
    puts "👉 Extract version of MISO iOS Swift package"

    package_resolved_content = File.read("../#{MISO_PACKAGE_RESOLVED_PATH}")
    package_resolved_json_content = JSON.parse(package_resolved_content)
    miso_ios_obj = package_resolved_json_content['pins'].find { |pin| pin["identity"] == "miso-ios" }
    miso_ios_branch = miso_ios_obj.dig("state", "branch") # Git branch
    miso_ios_revision = miso_ios_obj.dig("state", "revision") # Commit hash
    miso_ios_version = miso_ios_obj.dig("state", "version") # Git tag

    if miso_ios_branch && miso_ios_revision
        return "#{miso_ios_branch} (#{miso_ios_revision[0,7]})"
    elsif miso_ios_revision && miso_ios_version
        return "#{miso_ios_version} (#{miso_ios_revision[0,7]})"
    else
        raise error
    end
end

# Extract from Package.resolved details about the Git branch in use for the MISO iOS Swift Package.
# Returns the branch if defined or raises an error.
# Supposes the MISO iOS package is defined and used; if a local reference is used instead the branch won't be retrieved
def MISO_swift_package_git_branch()
    puts "👉 Extract Git branch of MISO iOS Swift package"

    package_resolved_content = File.read("../#{MISO_PACKAGE_RESOLVED_PATH}")
    package_resolved_json_content = JSON.parse(package_resolved_content)
    miso_ios_obj = package_resolved_json_content['pins'].find { |pin| pin["identity"] == "miso-ios" }
    miso_ios_branch = miso_ios_obj.dig("state", "branch")

    if miso_ios_branch
        return "#{miso_ios_branch}"
    else
        raise error
    end
end

# Read release note in section associated to the current version
# If empty, try within the Unreleased section
def read_current_release_notes
    version = get_iOS_app_version

    changelog = read_changelog(
        changelog_path: '../CHANGELOG.md',
        section_identifier: "[#{version}]",
    )

    if changelog == ""
        changelog = read_changelog(
            changelog_path: '../CHANGELOG.md',
            section_identifier: "[Unreleased]",
        )
    end

    puts "ℹ️ Current relaase notes = #{changelog}"
    return changelog
end
