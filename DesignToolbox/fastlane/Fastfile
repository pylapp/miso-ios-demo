# Non-platform specific lanes
# ---------------------------

desc "Run SwiftFormat to format Swift source files according to the local configuration and apply source header template."
lane :format do
    start_time = Time.now
    puts "👉 Run Swift Format to format sources"

    template = '\\nSPDX-FileCopyrightText: Copyright (c) Orange, Pierre-Yves Lapersonne\\nSPDX-License-Identifier: MIT'
    sh "cd .. && swiftformat . --header \"#{template}\""

    puts "👉 Run Swift Format to format sources"

    # Format sources of fork, copyrighted Orange, modified by Pierre-Yves Lapersonne
    templateOUDSFork = 'Software: MISO iOS (demo app) (fork of OUDS iOS Design System Toolbox)\\nSPDX-License-Identifier: MIT\\nSPDX-FileCopyrightText: Copyright (c) Orange SA, Pierre-Yves Lapersonne'
    sh "cd .. && swiftformat . --header \"#{templateOUDSFork}\" && cd .."

    # Format sources of MISO, not related to the fork, copyrighted Pierre-Yves Lapersonne only
    templateMISO = 'Software: MISO iOS (demo app)\\nSPDX-License-Identifier: MIT\\nSPDX-FileCopyrightText: Copyright (c) Pierre-Yves Lapersonne'
    sh "cd .. && swiftformat DesignToolbox/Pages/Components/MISO/ --header \"#{templateMISO}\" && cd .."
    sh "cd .. && swiftformat DesignToolboxSnapshotsTests/ --header \"#{templateMISO}\" && cd .."

    puts "⏱ Done in #{format_elapsed_time(Time.now - start_time)}"
end

desc "Run SwiftLint in strict mode to detect code smells using local configuration for app, snapshots, units and UI tests"
lane :lint do
    start_time = Time.now
    puts "👉 Run Swift Lint for smells"

    # If there are violations, error 2 will be returned by swiftlint, making Fastlane fail (expected)
    sh "cd .. && swiftlint --strict --config ../.swiftlint.yml DesignToolbox/* DesignToolboxSnapshotsTests/* DesignToolboxUITests/* DesignToolboxUnitTests/*"

    puts "⏱ Done in #{format_elapsed_time(Time.now - start_time)}"
end

desc "Run LicensePlist to update list of third-parties to embed in app"
lane :update_3rd_parties do
    start_time = Time.now
    puts "👉 Run LicensePlist to update list of third-parties"

    Dir.chdir ".." do
        # Run the command to generate assets
        sh "license-plist --add-version-numbers --add-sources --force --suppress-opening-directory"

        # Copy assets and delete temporary folders
        sh "rm -rf Settings.bundle/com.mono0926.LicensePlist &&  mv -f com.mono0926.LicensePlist.Output/com.mono0926.LicensePlist Settings.bundle"
        sh "rm -rf Settings.bundle/com.mono0926.LicensePlist.plist && mv com.mono0926.LicensePlist.Output/com.mono0926.LicensePlist.plist Settings.bundle"
        sh "rm -rf com.mono0926.LicensePlist.Output"
    end

    puts "⏱ Done in #{format_elapsed_time(Time.now - start_time)}"
end

desc "Run GitLeaks to look for leaks of secrets in project and Git history"
lane :check_leaks do
    start_time = Time.now
    puts "👉 Run Gitleaks for leaks scan"

    # If there are violations, non 0 error be returned by swiftlint, making Fastlane fail (expected)
    sh "cd .. && gitleaks detect -v -l debug --source ."

    puts "⏱ Done in #{format_elapsed_time(Time.now - start_time)}"
end

desc "Generates a SBOM (Software Bill Of Materials) in SPDX JSON format with Syft and analyse it with Grype to as to look for vulnerabilities"
lane :update_sbom do
    start_time = Time.now
    puts "👉 Run Syft to generate the SBOM"

    # Or also cyclonedx-json
    sbomFormat = "spdx-json"

    # In { negligible, low, medium, high, critical }
    vulnerabilitiesTolerance = "negligible"

     Dir.chdir "../.." do
        # Run the command to generate SBOM
        sh "syft . -o #{sbomFormat} > SBOM.json"

        # Process the SBOM
        sh "grype sbom:./SBOM.json --fail-on #{vulnerabilitiesTolerance}"
    end

    puts "⏱ Done in #{format_elapsed_time(Time.now - start_time)}"
 end

desc "UPDATE BUILD NUMBER WITH TIMESTAMP"
lane :update_build_number do
    puts "👉 Update build number"

    timestamp = sh 'date +%s' # Timestamp are unique, incremental and bring details about build date
    timestamp = timestamp.strip!
    puts "ℹ️ New builder number: '#{timestamp}'"

    increment_build_number(xcodeproj: MISO_PROJECT, build_number: timestamp)
end

# iOS Lanes
# ---------

# NOTE: Not so much specific test / build / upload lanes for macOS and visionOS as these platforms are not the more priorized
# Priority is first to iOS / iPadOS apps which are avaialble through TestFlight and App Store

platform :ios do

    desc "Run Periphery to look for dead code in the code base. Avoid strict mode because some false positive remains and command must be fine-tuned."
    lane :check_dead_code do
        start_time = Time.now
        puts "👉 Check iOS dead code with Periphery"

        sh "periphery scan --project ../#{MISO_WORKSPACE} --schemes #{MISO_SCHEME_IOS} --format xcode --clean-build"

        puts "⏱ Done in #{format_elapsed_time(Time.now - start_time)}"
    end
    
    desc "Run snapshots tests in the demo app to look for visual regressions of components defined in MISO package"
    lane :test_snapshots do
        start_time = Time.now
        puts "👉 Run snapshots tests"

        # Should have on runner one device under at least iOS 15
        # Check the available devices using `xcrun xctrace list devices`
        # Add new environments using `xcodebuild -downloadPlatform iOS`
        begin
            scan(scheme: MISO_SCHEME_SNAPSHOTS_TESTS,
                device: MISO_SNAPSHOTS_TEST_DEVICE,
                skip_build: true,
                result_bundle: true,
                xcargs: "-testLanguage en -testRegion en_US"
            )

            if MATTERMOST_HOOK_URL.nil? || MATTERMOST_HOOK_URL.empty?
                puts "ℹ️ No MATTERMOST_HOOK_URL defined, it could mean this lane is called on GitHub Action workflow or locally"
            else
                publish_mattermost_notification("🧪 ✅ No issue with snapshots tests")
            end
        rescue => error
            if MATTERMOST_HOOK_URL.nil? || MATTERMOST_HOOK_URL.empty?
                puts "ℹ️ No MATTERMOST_HOOK_URL defined, it could mean this lane is called on GitHub Action workflow or locally"
            else
                publish_mattermost_notification("🧪 🚨 @channel Some issue occured with tests (:test_snapshots)")
            end
            raise error
        ensure
            puts "⏱ Done in #{format_elapsed_time(Time.now - start_time)}"
        end
    end

    desc "Run UI tests in the demo app to check some specific components behaviors"
    lane :test_ui do
        start_time = Time.now
        puts "👉 Run UI tests"

        # Should have on runner one device under at least iOS 15
        # Check the available devices using `xcrun xctrace list devices`
        # Add new environments using `xcodebuild -downloadPlatform iOS`
        begin
            scan(scheme: MISO_SCHEME_UI_TESTS,
                device: MISO_UI_TEST_DEVICE,
                skip_build: true,
                xcargs: "-testLanguage en -testRegion en_US"
            )

            if MATTERMOST_HOOK_URL.nil? || MATTERMOST_HOOK_URL.empty?
                puts "ℹ️ No MATTERMOST_HOOK_URL defined, it could mean this lane is called on GitHub Action workflow or locally"
            else
                publish_mattermost_notification("🧪 ✅ No issue with UI tests")
            end
        rescue => error
            if MATTERMOST_HOOK_URL.nil? || MATTERMOST_HOOK_URL.empty?
                puts "ℹ️ No MATTERMOST_HOOK_URL defined, it could mean this lane is called on GitHub Action workflow or locally"
            else
                publish_mattermost_notification("🧪 🚨 @channel Some issue occured with tests (:test_ui)")
            end
            raise error
        ensure
            puts "⏱ Done in #{format_elapsed_time(Time.now - start_time)}"
        end
    end

    desc "Run Unit tests in the demo app to check some specific components behaviors"
    lane :test_unit do
        start_time = Time.now
        puts "👉 Run unit tests"

        # Should have on runner one device under at least iOS 15
        # Check the available devices using `xcrun xctrace list devices`
        # Add new environments using `xcodebuild -downloadPlatform iOS`
        begin
            scan(scheme: MISO_SCHEME_UNIT_TESTS,
                device: MISO_UNIT_TEST_DEVICE,
                skip_build: true,
                result_bundle: true,
                xcargs: "-testLanguage en -testRegion en_US"
            )

            if MATTERMOST_HOOK_URL.nil? || MATTERMOST_HOOK_URL.empty?
                puts "ℹ️ No MATTERMOST_HOOK_URL defined, it could mean this lane is called on GitHub Action workflow or locally"
            else
                publish_mattermost_notification("🧪 ✅ No issue with unit tests")
            end
        rescue => error
            if MATTERMOST_HOOK_URL.nil? || MATTERMOST_HOOK_URL.empty?
                puts "ℹ️ No MATTERMOST_HOOK_URL defined, it could mean this lane is called on GitHub Action workflow or locally"
            else
                publish_mattermost_notification("🧪 🚨 @channel Some issue occured with tests (:test_unit)")
            end
            raise error
        ensure
            puts "⏱ Done in #{format_elapsed_time(Time.now - start_time)}"
        end
    end

    desc "Build locally the demo app in debug mode without upload"
    lane :build_debug do
        puts "👉 Build debug app"

        Dir.chdir "../#{MISO_PROJECT_NAME}/Resources/Assets.xcassets" do
            sh "rm -Rf AppIconRelease.appiconset"
            sh "cp -R AppIconDebug.appiconset AppIconRelease.appiconset"
        end

        gym(
            scheme: MISO_SCHEME_IOS,
            output_directory: 'build/',
            archive_path: 'build/',
            output_name: 'misoApp',
            configuration: 'Debug',
            include_symbols: true,
            skip_archive: true,
            skip_codesigning: true,
            destination: "generic/platform=iOS Simulator"
        )
    end

    # Get version set in the Xcode project
    def get_iOS_app_version()
        version = get_version_number(
            xcodeproj: MISO_PROJECT,
            target: MISO_TARGET_IOS
        )
        return version
    end    
end

